# Modo de dados do front-end: "mock" (padrão — dados simulados em memória,
# sem nenhuma dependência externa) ou "api" (repositories reais, via BFF do
# Next.js em src/app/api/* -> backend NestJS). Ver README.md para detalhes.
NEXT_PUBLIC_APP_MODE=mock

# URL do backend NestJS, usada SOMENTE do lado do servidor (Route Handlers em
# src/app/api/*). Nunca é exposta ao navegador (sem prefixo NEXT_PUBLIC_).
BACKEND_INTERNAL_URL=http://localhost:3001

# Tenant padrão pré-preenchido na tela de login em modo "api" (opcional —
# apenas conveniência de desenvolvimento, o campo continua editável).
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=beehome-brasil
