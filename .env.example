# Modo de dados do front-end: "mock" (padrão — dados simulados em memória,
# sem nenhuma dependência externa) ou "api" (dados reais). Ver README.md.
NEXT_PUBLIC_APP_MODE=mock

# Tenant padrão pré-preenchido na tela de login em modo "api" (opcional —
# apenas conveniência de desenvolvimento, o campo continua editável).
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=beehome-brasil

# ---------------------------------------------------------------------------
# Modo "api" SEM banco de dados — os Route Handlers em src/app/api/* buscam
# direto na BeeHome a cada requisição (tempo real, sem histórico próprio).
# Todas as páginas de dado já migraram para esse modo.
# ---------------------------------------------------------------------------

# Única conta do sistema (Bruna, administradora) — sem tabela de usuários.
ADMIN_LOGIN="12457832659"
ADMIN_PASSWORD="troque-esta-senha"

# Assina a sessão (cookie httpOnly). Nunca deixe sem valor em produção —
# não existe fallback, de propósito (ver src/lib/server/admin-session.ts).
JWT_SECRET="troque-este-valor-por-um-segredo-forte"

# Integração com a Intranet BeeHome — mesmos nomes que o backend usava.
# BEEHOME_BEARER_TOKEN pode ser atualizado sem redeploy: a tela Administração
# > Integrações permite colar um token novo, que passa a valer por até 20 min
# (cookie httpOnly, ver src/lib/server/beehome-token.ts) sem precisar mexer
# nesta variável.
BEEHOME_BASE_URL="https://conectamericas.mybeehome.com"
BEEHOME_BEARER_TOKEN="nunca-commitar-token-real-aqui"
BEEHOME_TIMEOUT_MS=10000
BEEHOME_MAX_RETRIES=3
BEEHOME_RETRY_BASE_MS=300

# IA de Insights (tela "Insights com IA") — opcional: sem esta chave, a tela
# fica honestamente vazia (sem modelo configurado), como sempre foi. Com ela,
# passa a gerar observações/respostas reais em cima dos dados já validados
# da BeeHome — nunca inventa dado ausente (regras em src/lib/server/ai-insights.ts).
# Nunca commitar a chave real aqui — configurar como variável de ambiente no
# provedor de deploy (mesma lógica do BEEHOME_BEARER_TOKEN acima).
OPENAI_API_KEY="nunca-commitar-chave-real-aqui"

# ---------------------------------------------------------------------------
# Legado da arquitetura anterior (com banco/backend NestJS) — não usado pelo
# modo "api" atual. Mantido só como referência histórica no repositório.
# ---------------------------------------------------------------------------
BACKEND_INTERNAL_URL=http://localhost:3001
