# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://beehome:beehome@localhost:5432/beehome_backend?schema=public"

# JWT do próprio SaaS (NÃO é o token da BeeHome — ver BEEHOME_BEARER_TOKEN abaixo)
JWT_SECRET="troque-este-valor-por-um-segredo-forte"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Integração com a Intranet BeeHome
# TODO: confirmar com o time BeeHome o DNS específico por tenant, ciclo de
# vida do token (expiração/renovação) e rate limits antes de ir para produção.
BEEHOME_BASE_URL="https://SEU-TENANT.beehome.example.com"
BEEHOME_BEARER_TOKEN="nunca-commitar-token-real-aqui"
BEEHOME_TIMEOUT_MS=10000
BEEHOME_MAX_RETRIES=3
BEEHOME_RETRY_BASE_MS=300

# Redis (cache/filas — BullMQ). Por padrão o SyncModule roda em modo
# fallback (execução direta, sem fila), mesmo com REDIS_URL preenchido —
# isso evita que o processo derrube ao tentar conectar em um Redis que não
# está de pé. Para usar a fila BullMQ de verdade, defina explicitamente
# SYNC_QUEUE_DRIVER=redis (com Redis realmente disponível em REDIS_URL).
# Ver src/sync/queue/sync-queue.module.ts
REDIS_URL="redis://localhost:6379"
SYNC_QUEUE_DRIVER=memory

# Servidor
PORT=3001
